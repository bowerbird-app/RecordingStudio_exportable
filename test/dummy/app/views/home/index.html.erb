  <%= render FlatPack::PageTitle::Component.new(
    title: "Exports",
    subtitle: "Download a CSV from the pages you can open.",
    variant: :h1
  ) %>

  <% if @current_actor_email %>
    <%= render FlatPack::Content::Component.new do %>
      <p>Signed in as <%= @current_actor_email %>.</p>
    <% end %>
  <% end %>

  <div class="space-y-8">
    <section id="demo-api-requests" class="space-y-3">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Demo API requests",
        subtitle: "Required role: view",
        spacing: :none
      ) %>

      <% if @demo_dashboard && @demo_recording %>
        <%= recording_studio_export_access_button(
          context_recording: @demo_recording,
          export_key: "recording_studio_demo_dashboard_requests_export",
          text: "Export API requests",
          style: :secondary,
          size: :md,
          unauthorized_behavior: :disable,
          unauthorized_text: "Export restricted"
        ) %>

        <% rows = Array(@demo_dashboard.demo_api_requests).map do |request|
             {
               path: request.path,
               method: request.http_method,
               status: request.status,
               duration: "#{request.duration_ms} ms"
             }
           end %>

        <%= render FlatPack::Table::Component.new(data: rows, class: "text-sm") do |table| %>
          <% table.column(title: "Path") { |row| row[:path] } %>
          <% table.column(title: "Method") { |row| row[:method] } %>
          <% table.column(title: "Status") { |row|
            next if row[:status].blank?

            badge_style = row[:status].to_i.between?(200, 299) ? :success : :default
            render(FlatPack::Badge::Component.new(text: row[:status].to_s, style: badge_style, size: :sm))
          } %>
          <% table.column(title: "Duration") { |row| row[:duration] } %>
        <% end %>
      <% else %>
        <%= render FlatPack::Content::Component.new do %>
          <p>Run <code>bin/rails db:seed</code> to create demo dashboard data.</p>
        <% end %>
      <% end %>
    </section>

    <section class="space-y-3">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Articles",
        subtitle: "Required role: admin",
        spacing: :none
      ) %>

      <% if @article_rows.any? %>
        <%= recording_studio_export_access_button(
          context_recording: @demo_recording || @article_rows.first[:context_recording],
          export_key: "recording_studio_article_export",
          text: "Export Articles",
          style: :secondary,
          size: :md,
          unauthorized_behavior: :disable,
          unauthorized_text: "Export Articles (admin required)"
        ) %>

        <%= render FlatPack::Table::Component.new(data: @article_rows, class: "text-sm") do |table| %>
          <% table.column(title: "Article") { |row| row[:title] } %>
          <% table.column(title: "Author") { |row| row[:author_name] } %>
          <% table.column(title: "Topics") { |row| row[:topic_count].to_s } %>
          <% table.column(title: "Word count") { |row| row[:word_count].to_s } %>
        <% end %>
      <% else %>
        <%= render FlatPack::Content::Component.new do %>
          <p>Run <code>bin/rails db:seed</code> to create demo article data.</p>
        <% end %>
      <% end %>
    </section>

    <section class="space-y-3">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Article topics and authors",
        subtitle: "Required role: view",
        spacing: :none
      ) %>

      <% if @article_topic_rows.any? %>
        <%= render FlatPack::Content::Component.new do %>
          <p>Showing <%= @article_topic_rows_page.length %> of <%= @article_topics_total_rows %> rows on page <%= @article_topics_page %> of <%= @article_topics_total_pages %>. Export includes all matching rows, not just this page.</p>
        <% end %>

        <%= recording_studio_export_access_button(
          context_recording: @demo_recording || @article_rows.first[:context_recording],
          export_key: "recording_studio_article_topics_authors_export",
          text: "Export Articles with Authors and Topics",
          style: :secondary,
          size: :md,
          unauthorized_behavior: :disable,
          unauthorized_text: "Export restricted"
        ) %>

        <%= render FlatPack::Table::Component.new(data: @article_topic_rows_page, class: "text-sm") do |table| %>
          <% table.column(title: "Article") { |row| row[:article_title] } %>
          <% table.column(title: "Topic") { |row| row[:topic_name] } %>
          <% table.column(title: "Author") { |row| row[:author_name] } %>
        <% end %>

        <%= render FlatPack::Pagination::Component.new(
          pagy: HomeHelper::PageNav.new(
            page: @article_topics_page,
            pages: @article_topics_total_pages,
            page_param: :article_topics_page
          )
        ) %>
      <% else %>
        <%= render FlatPack::Content::Component.new do %>
          <p>Run <code>bin/rails db:seed</code> to create article topics.</p>
        <% end %>
      <% end %>
    </section>

    <section id="topics" class="space-y-3">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Topics",
        subtitle: "Required role: admin",
        spacing: :none
      ) %>

      <%= form_with url: root_path(anchor: "topics"), method: :get, local: true, class: "grid gap-3 md:grid-cols-3" do %>
        <%= render FlatPack::TextInput::Component.new(
          name: "topic",
          label: "Filter by topic",
          value: @topic_filter,
          placeholder: "topic name"
        ) %>

        <%= render FlatPack::TextInput::Component.new(
          name: "article",
          label: "Filter by article",
          value: @article_filter,
          placeholder: "article title"
        ) %>

        <div class="md:col-span-3">
          <%= render FlatPack::DateRangeInput::Component.new(
            start_name: "topics_created_at_start",
            end_name: "topics_created_at_end",
            label: "Created at",
            placeholder: "Filter created at range",
            start_value: @topics_created_at_start,
            end_value: @topics_created_at_end,
            class: "md:max-w-md"
          ) %>
        </div>

        <div class="flex items-end gap-2">
          <% @topics_selected_columns.each do |column_key| %>
            <%= hidden_field_tag "topics_columns[]", column_key %>
          <% end %>
          <%= render FlatPack::Button::Component.new(text: "Apply filters", type: "submit", style: :primary, size: :md) %>
          <%= render FlatPack::Button::Component.new(text: "Reset", href: root_path(anchor: "topics"), style: :ghost) %>
        </div>
      <% end %>

      <% if @topic_article_rows.any? && @demo_recording %>
        <div class="flex items-center gap-2">
          <%= render FlatPack::Button::Component.new(
            text: "Columns",
            type: "button",
            style: :secondary,
            size: :sm,
            data: { action: "click->flat-pack--modal#open", "modal-id": "topics-columns-modal" }
          ) %>

          <%= render FlatPack::Content::Component.new do %>
            <p>Created at is visible in the table but not exportable.</p>
          <% end %>
        </div>

        <%= render FlatPack::Modal::Component.new(id: "topics-columns-modal", title: "Choose Topic Columns", size: :md) do |modal| %>
          <% modal.body do %>
            <%= render FlatPack::Content::Component.new do %>
              <p>Checked columns are shown in the table and sent as export columns.</p>
            <% end %>

            <%= form_with url: root_path(anchor: "topics"), method: :get, local: true, class: "space-y-3" do %>
              <%= hidden_field_tag :topic, @topic_filter %>
              <%= hidden_field_tag :article, @article_filter %>
              <%= hidden_field_tag :topics_created_at_start, @topics_created_at_start %>
              <%= hidden_field_tag :topics_created_at_end, @topics_created_at_end %>

              <div class="space-y-2">
                <% @topics_column_options.each do |column| %>
                  <%= render FlatPack::Checkbox::Component.new(
                    name: "topics_columns[]",
                    label: column[:title],
                    value: column[:key],
                    checked: @topics_selected_columns.include?(column[:key])
                  ) %>
                <% end %>
              </div>

              <div class="flex items-center justify-end gap-2 pt-2">
                <%= render FlatPack::Button::Component.new(
                  text: "Cancel",
                  type: "button",
                  style: :ghost,
                  size: :sm,
                  data: { action: "click->flat-pack--modal#close" }
                ) %>
                <%= render FlatPack::Button::Component.new(text: "Apply columns", type: "submit", style: :primary, size: :sm) %>
              </div>
            <% end %>
          <% end %>
        <% end %>

        <%= render FlatPack::Content::Component.new do %>
          <p>Showing <%= @topic_article_rows_page.length %> of <%= @topics_total_rows %> rows on page <%= @topics_page %> of <%= @topics_total_pages %>. Export includes all matching rows, not just this page.</p>
        <% end %>

        <%= recording_studio_export_access_button(
          context_recording: @demo_recording,
          export_key: "recording_studio_topics_articles_export",
          columns: @topics_selected_columns,
          filters: { topic: @topic_filter, article: @article_filter },
          text: "Export Topics",
          style: :secondary,
          size: :md,
          unauthorized_behavior: :disable,
          unauthorized_text: "Export Topics (admin required)"
        ) %>

        <%= render FlatPack::Table::Component.new(data: @topic_article_rows_page, class: "text-sm") do |table| %>
          <% if @topics_selected_columns.include?("topic_name") %>
            <% table.column(title: "Topic") { |row| row[:topic_name] } %>
          <% end %>
          <% if @topics_selected_columns.include?("article_titles") %>
            <% table.column(title: "Articles") { |row| row[:article_titles] } %>
          <% end %>
          <% if @topics_selected_columns.include?("topic_created_at") %>
            <% table.column(title: "Created at", wrap: :nowrap) { |row|
              next if row[:topic_created_at].blank?

              render(FlatPack::Timestamp::Component.new(timestamp: row[:topic_created_at], shorten_timestamp: true))
            } %>
          <% end %>
        <% end %>

        <%= render FlatPack::Pagination::Component.new(
          pagy: HomeHelper::PageNav.new(
            page: @topics_page,
            pages: @topics_total_pages,
            page_param: :topics_page,
            extra: { topics_columns: @topics_selected_columns }
          ),
          anchor: "topics"
        ) %>
      <% else %>
        <%= render FlatPack::Content::Component.new do %>
          <p>Run <code>bin/rails db:seed</code> to create topic data.</p>
        <% end %>
      <% end %>
    </section>

    <section class="space-y-3">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Documents",
        subtitle: "Page access role: admin. Export role: view",
        spacing: :none
      ) %>

      <% if @documents.any? %>
        <%= render FlatPack::Table::Component.new(data: @documents, class: "text-sm") do |table| %>
          <% table.column(title: "Document") { |row|
            render(FlatPack::Link::Component.new(href: document_path(row))) { row.title }
          } %>
          <% table.column(title: "Items") { |row| row.items.count } %>
        <% end %>
      <% else %>
        <%= render FlatPack::Content::Component.new do %>
          <p>Run <code>bin/rails db:seed</code> to create document data.</p>
        <% end %>
      <% end %>
    </section>

    <section class="space-y-3">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Trusted export token demo",
        subtitle: "This button uses a single-use token. The page issues it, and the export link posts it to the engine.",
        spacing: :none
      ) %>

      <% if @trusted_token.present? %>
        <%= render FlatPack::Card::Component.new do |card| %>
          <% card.body do %>
          <%= render FlatPack::Content::Component.new do %>
            <p><span class="font-medium">Token ID:</span> <code class="break-all"><%= @trusted_token.id %></code></p>
          <% end %>
          <%= render FlatPack::Content::Component.new do %>
            <p>Token expires in 30 seconds. Single use only. Source: <code><%= @trusted_token.source %></code></p>
          <% end %>

          <%= tag.form(action: recording_studio_exportable.exports_path, method: :post) do %>
            <%= hidden_field_tag(:authenticity_token, form_authenticity_token) %>
            <%= hidden_field_tag(:export_token, @trusted_token.id) %>
            <%= hidden_field_tag(:format, :csv) %>
            <%= render FlatPack::Button::Component.new(
              text: "Export Articles (token-based)",
              icon: "arrow-down-tray",
              type: "submit",
              style: :secondary,
              size: :md
            ) %>
          <% end %>

          <%= render FlatPack::Content::Component.new do %>
            <p>After you export, refresh the page for a new token. The old one is used up.</p>
          <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= render FlatPack::Card::Component.new do |card| %>
          <% card.body do %>
            <%= render FlatPack::Content::Component.new do %>
              <p>
                To enable the token demo, add <code>RecordingStudioExportable</code>
                to <code>config.trusted_export_sources</code>. See the
                <%= render FlatPack::Link::Component.new(href: docs_trusted_exports_path) do %>
                  trusted exports docs
                <% end %>
                for setup.
              </p>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </section>
  </div>
