<%= render FlatPack::PageTitle::Component.new(
    title: "Gem Views",
    subtitle: "File names under app/views/recording_studio_exportable/exports/.",
    variant: :h1
  ) %>

<% view_rows = Array(@engine_views).map { |view_path| { path: File.basename(view_path), source: "Gem engine" } } %>

<%= render FlatPack::Table::Component.new(data: view_rows, min_width: :none) do |table| %>
  <% table.column(title: "View") { |view| view[:path] } %>
  <% table.column(title: "Source") { |view| view[:source] } %>
<% end %>
